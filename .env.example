# Copy this file to .env.local (or set these in your host's dashboard) and fill in real values.
# Every variable here is optional except the Supabase pair — the app runs in
# local/no-backend demo mode if VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY are unset.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Push notifications (Web Push / VAPID) — see PRODUCTION_READINESS.md
VITE_VAPID_PUBLIC_KEY=

# Remote error monitoring (Sentry) — sign up free at sentry.io, create a
# React/browser project, paste its DSN here. Leave blank to keep console-only
# error logging (current default behavior).
VITE_SENTRY_DSN=

# Bot/abuse protection on signup, login, and password reset (Cloudflare
# Turnstile) — create a free widget at dash.cloudflare.com/?to=/:account/turnstile,
# paste the SITE key here, and the SECRET key into Supabase Dashboard →
# Authentication → Attack Protection → Enable CAPTCHA protection. Leave blank
# to keep auth working exactly as it does today (no CAPTCHA).
VITE_TURNSTILE_SITE_KEY=
